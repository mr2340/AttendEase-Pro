# AttendEase Pro - Simplified Routing
RewriteEngine On

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Basic Security
Options -Indexes
Options +FollowSymLinks

# Custom Error Pages
ErrorDocument 404 /sodex/errors/404.php
ErrorDocument 403 /sodex/errors/403.php
ErrorDocument 500 /sodex/errors/500.php
